<title>Responsive Flex Layout</title>

<style>

body {
  margin: 0;
  font-family: Arial;
}


.container {
  display: flex;
  flex-direction: column;
}

.header, .footer {
  background: #d8d2b8;
  padding: 20px;
}

.main {
  display: flex;
}

.left, .right {
  background: green;
  border: 5px solid yellow;
  padding: 120px;
}


@media (min-width: 800px) {
  .main {
    flex-direction: row;
  }
  .left {
    width: 35%;
  }
  .right {
    width: 70%;
  }
}


@media (max-width: 400px) {
  .main {
    flex-direction: column;
  }
  .right {
    order: 1;
  }
  .left {
    order: 2;
  }
}

</style>
</head>

<body>

<div class="container">

  <div class="header">This is a Header</div>

  <div class="main">
    <div class="left">Section left-nav</div>
    <div class="right">Section right-nav</div>
  </div>

  <div class="footer">This is a footer</div>

</div>

</body>
